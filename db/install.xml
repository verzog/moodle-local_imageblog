<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/imageblog/db" VERSION="20261018" COMMENT="XMLDB file for local_imageblog">
  <TABLES>

    <TABLE NAME="local_imageblog_posts" COMMENT="Blog posts">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="authorid"        TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="mdl_user.id"/>
        <FIELD NAME="title"           TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="summary"         TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Short excerpt shown on card"/>
        <FIELD NAME="body"            TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Full post HTML from TinyMCE"/>
        <FIELD NAME="bodyformat"      TYPE="int"  LENGTH="4"  NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="status"          TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="draft" SEQUENCE="false" COMMENT="draft|scheduled|published|archived"/>
        <FIELD NAME="timescheduled"   TYPE="int"  LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Future timestamp when scheduled posts auto-publish"/>
        <FIELD NAME="timepublished"   TYPE="int"  LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated"     TYPE="int"  LENGTH="10" NOTNULL="true"  SEQUENCE="false"/>
        <FIELD NAME="timemodified"    TYPE="int"  LENGTH="10" NOTNULL="true"  SEQUENCE="false"/>
        <FIELD NAME="lazyimages"     TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="1=lazy load body images"/>
        <FIELD NAME="forumpostid"     TYPE="int"  LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Linked forum discussion id"/>
        <FIELD NAME="featuredimage"   TYPE="int"  LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="mdl_files id for card thumbnail"/>
        <FIELD NAME="posttype"        TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="blog" SEQUENCE="false" COMMENT="blog|news|reference|patientcase|casestudy|tutorial|review|designeval"/>
        <FIELD NAME="assessmentmode" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="none" SEQUENCE="false" COMMENT="none|practice|assessable; whether an interactive post earns CPD"/>
        <FIELD NAME="caseoutcome"     TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Author-provided outcome/diagnosis, shown after reveal"/>
        <FIELD NAME="caseoutcomeformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="caserevealed"    TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="1 once the author has revealed the outcome"/>
        <FIELD NAME="caserevealedtime" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="caserevealat"    TYPE="int"  LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Timestamp for scheduled auto-reveal; null = none set"/>
        <FIELD NAME="casebestdiagnosisid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Optional id of best diagnosis chosen by author"/>
        <FIELD NAME="casedifficulty"  TYPE="int"  LENGTH="2"  NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Author-rated difficulty 1-5 used for CPD scaling"/>
        <FIELD NAME="rubricid"        TYPE="int"  LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Chosen rubric template for evaluate posts; null otherwise"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_author" TYPE="foreign" FIELDS="authorid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_status_published" UNIQUE="false" FIELDS="status, timepublished"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_imageblog_tags" COMMENT="Tag definitions">
      <FIELDS>
        <FIELD NAME="id"    TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name"  TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="slug"  TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_slug" UNIQUE="true" FIELDS="slug"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_imageblog_post_tags" COMMENT="Many-to-many: posts to tags">
      <FIELDS>
        <FIELD NAME="id"      TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="postid"  TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="tagid"   TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_post" TYPE="foreign" FIELDS="postid" REFTABLE="local_imageblog_posts" REFFIELDS="id"/>
        <KEY NAME="fk_tag"  TYPE="foreign" FIELDS="tagid"  REFTABLE="local_imageblog_tags"  REFFIELDS="id"/>
      </KEYS>
    </TABLE>

    <TABLE NAME="local_imageblog_levels" COMMENT="Difficulty level tags (All Levels, Advanced, Fellowship etc.)">
      <FIELDS>
        <FIELD NAME="id"         TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name"       TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="colourkey"  TYPE="char" LENGTH="20"  NOTNULL="true" DEFAULT="amber" SEQUENCE="false" COMMENT="amber|teal|coral|purple"/>
        <FIELD NAME="sortorder"  TYPE="int"  LENGTH="4"   NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>

    <TABLE NAME="local_imageblog_post_levels" COMMENT="Many-to-many: posts to levels">
      <FIELDS>
        <FIELD NAME="id"       TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="postid"   TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="levelid"  TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_post"  TYPE="foreign" FIELDS="postid"  REFTABLE="local_imageblog_posts"  REFFIELDS="id"/>
        <KEY NAME="fk_level" TYPE="foreign" FIELDS="levelid" REFTABLE="local_imageblog_levels" REFFIELDS="id"/>
      </KEYS>
    </TABLE>

    <TABLE NAME="local_imageblog_case_diags" COMMENT="Reader-submitted diagnoses on a case post">
      <FIELDS>
        <FIELD NAME="id"            TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="postid"        TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid"        TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="diagnosis"     TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="reasoning"     TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated"   TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified"  TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_post" TYPE="foreign" FIELDS="postid" REFTABLE="local_imageblog_posts" REFFIELDS="id"/>
        <KEY NAME="fk_user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_post_user" UNIQUE="true" FIELDS="postid, userid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_imageblog_case_qs" COMMENT="Reader questions and author answers on a case post">
      <FIELDS>
        <FIELD NAME="id"            TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="postid"        TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid"        TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Asker"/>
        <FIELD NAME="question"      TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="answer"        TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="answeredby"    TYPE="int"  LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timeasked"     TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timeanswered"  TYPE="int"  LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_post" TYPE="foreign" FIELDS="postid" REFTABLE="local_imageblog_posts" REFFIELDS="id"/>
        <KEY NAME="fk_user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
    </TABLE>

    <TABLE NAME="local_imageblog_case_cpd" COMMENT="CPD hours awarded for case participation">
      <FIELDS>
        <FIELD NAME="id"            TYPE="int"    LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="postid"        TYPE="int"    LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid"        TYPE="int"    LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="hours"         TYPE="number" LENGTH="6" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="reason"        TYPE="char"   LENGTH="40" NOTNULL="true" SEQUENCE="false" COMMENT="participation|bestanswer|view"/>
        <FIELD NAME="timeawarded"   TYPE="int"    LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_post" TYPE="foreign" FIELDS="postid" REFTABLE="local_imageblog_posts" REFFIELDS="id"/>
        <KEY NAME="fk_user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_post_user_reason" UNIQUE="true" FIELDS="postid, userid, reason"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_imageblog_subs" COMMENT="Per-user subscription preferences for new post digests">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"       TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="frequency"    TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="weekly" SEQUENCE="false" COMMENT="daily|weekly|monthly"/>
        <FIELD NAME="lastsent"     TYPE="int"  LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_userid" UNIQUE="true" FIELDS="userid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_imageblog_rubrics" COMMENT="Admin-defined evaluation rubric templates">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name"         TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="description"  TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="maxscore"     TYPE="int"  LENGTH="2"  NOTNULL="true" DEFAULT="5" SEQUENCE="false" COMMENT="Top of the 1..maxscore rating scale"/>
        <FIELD NAME="sortorder"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_imageblog_rubric_crit" COMMENT="Criteria belonging to a rubric template">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="rubricid"    TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="name"        TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="sortorder"   TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_rubric" TYPE="foreign" FIELDS="rubricid" REFTABLE="local_imageblog_rubrics" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_imageblog_eval_refs" COMMENT="Author reference (model) score per criterion for an evaluate post">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="postid"      TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="criterionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="refscore"    TYPE="int" LENGTH="4"  NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_post" TYPE="foreign" FIELDS="postid" REFTABLE="local_imageblog_posts" REFFIELDS="id"/>
        <KEY NAME="fk_crit" TYPE="foreign" FIELDS="criterionid" REFTABLE="local_imageblog_rubric_crit" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_post_crit" UNIQUE="true" FIELDS="postid, criterionid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_imageblog_evals" COMMENT="Reader evaluation submission on an evaluate post">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="postid"       TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid"       TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="commenttext"  TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_post" TYPE="foreign" FIELDS="postid" REFTABLE="local_imageblog_posts" REFFIELDS="id"/>
        <KEY NAME="fk_user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_post_user" UNIQUE="true" FIELDS="postid, userid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_imageblog_eval_scores" COMMENT="Reader score per criterion within an evaluation">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="evalid"      TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="criterionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="score"       TYPE="int" LENGTH="4"  NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_eval" TYPE="foreign" FIELDS="evalid" REFTABLE="local_imageblog_evals" REFFIELDS="id"/>
        <KEY NAME="fk_crit" TYPE="foreign" FIELDS="criterionid" REFTABLE="local_imageblog_rubric_crit" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_eval_crit" UNIQUE="true" FIELDS="evalid, criterionid"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
