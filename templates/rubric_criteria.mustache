{{!
    @template local_imageblog/rubric_criteria

    Admin list of the criteria within one rubric template.

    Context variables required for this template:
    * name    - template name
    * rows    - array of {name, description, sortorder, editurl, deleteurl}
    * hasrows - boolean
    * addurl  - URL to add a criterion
    * backurl - URL back to the template list

    Example context (json):
    {
        "name": "Default rubric",
        "rows": [],
        "hasrows": false,
        "addurl": "https://moodle.local/local/imageblog/rubrics.php?action=addcrit&rubricid=1",
        "backurl": "https://moodle.local/local/imageblog/rubrics.php"
    }
}}
<div class="local-imageblog-rubric-criteria">
    <p>
        <a href="{{backurl}}">&laquo; {{#str}}rubric_back, local_imageblog{{/str}}</a>
    </p>
    <h3 class="h4">{{name}}</h3>
    <p><a class="btn btn-primary" href="{{addurl}}">{{#str}}rubric_addcriterion, local_imageblog{{/str}}</a></p>

    {{#hasrows}}
        <table class="generaltable">
            <thead>
                <tr>
                    <th>{{#str}}name{{/str}}</th>
                    <th>{{#str}}description{{/str}}</th>
                    <th>{{#str}}sortorder, local_imageblog{{/str}}</th>
                    <th>{{#str}}actions{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                    <tr>
                        <td>{{name}}</td>
                        <td>{{description}}</td>
                        <td>{{sortorder}}</td>
                        <td>
                            <a href="{{editurl}}">{{#str}}edit{{/str}}</a>
                            &middot;
                            <a href="{{deleteurl}}" data-action="delete">{{#str}}delete{{/str}}</a>
                        </td>
                    </tr>
                {{/rows}}
            </tbody>
        </table>
    {{/hasrows}}
    {{^hasrows}}
        <div class="alert alert-info">{{#str}}rubric_nocriteria, local_imageblog{{/str}}</div>
    {{/hasrows}}
</div>
