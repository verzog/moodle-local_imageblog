{{!
    @template local_imageblog/rubric_index

    Admin index listing evaluation rubric templates.

    Context variables required for this template:
    * rows    - array of {name, maxscore, critcount, criteriaurl, editurl, deleteurl}
    * hasrows - boolean
    * addurl  - URL to add a new template

    Example context (json):
    {
        "rows": [],
        "hasrows": false,
        "addurl": "https://moodle.local/local/imageblog/rubrics.php?action=add"
    }
}}
<div class="local-imageblog-rubrics">
    <p><a class="btn btn-primary" href="{{addurl}}">{{#str}}rubric_add, local_imageblog{{/str}}</a></p>

    {{#hasrows}}
        <table class="generaltable">
            <thead>
                <tr>
                    <th>{{#str}}name{{/str}}</th>
                    <th>{{#str}}rubric_maxscore, local_imageblog{{/str}}</th>
                    <th>{{#str}}rubric_criteria, local_imageblog{{/str}}</th>
                    <th>{{#str}}actions{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                    <tr>
                        <td><a href="{{criteriaurl}}">{{name}}</a></td>
                        <td>{{maxscore}}</td>
                        <td>{{critcount}}</td>
                        <td>
                            <a href="{{criteriaurl}}">{{#str}}rubric_criteria, local_imageblog{{/str}}</a>
                            &middot;
                            <a href="{{editurl}}">{{#str}}edit{{/str}}</a>
                            &middot;
                            <a href="{{deleteurl}}" data-action="delete">{{#str}}delete{{/str}}</a>
                        </td>
                    </tr>
                {{/rows}}
            </tbody>
        </table>
    {{/hasrows}}
    {{^hasrows}}
        <div class="alert alert-info">{{#str}}rubric_none, local_imageblog{{/str}}</div>
    {{/hasrows}}
</div>
